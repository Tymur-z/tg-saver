BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
OWNER_ID=0
ADMIN_IDS=

DATABASE_PATH=data/forwarder.db

LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

FORWARD_RATE_LIMIT_PER_MINUTE=20
QUEUE_MAX_SIZE=500
ALBUM_DEBOUNCE_SECONDS=0.8
MAX_RETRY_ATTEMPTS=3

ANALYTICS_ENABLED=true
DATA_RETENTION_DAYS=30
MIN_MESSAGES_FOR_ANALYSIS=10
DISCARD_RAW_TEXT_AFTER_ANALYSIS=true

ACCESS_PASSWORD=changeme
PASSWORD_REQUIRED=true

# Optional LLM integration (OpenAI API / Google Gemini / DeepSeek / Ollama)
# Set LLM_ENABLED=true and specify LLM_API_KEY to activate deep AI moderation and style analysis
LLM_ENABLED=false
LLM_API_KEY=

# OpenAI configuration:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Google Gemini configuration (OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-flash

LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
